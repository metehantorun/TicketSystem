@{
    ViewData["Title"] = "Hata";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div style="width:80px;height:80px;border-radius:16px;background:rgba(255,60,60,0.1);border:1px solid rgba(255,80,80,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
            <i class="bi bi-exclamation-triangle" style="font-size:2.5rem;color:rgba(255,80,80,0.6);"></i>
        </div>
        <h4 style="color:#d0e8ff;font-weight:700;">Bir hata oluştu</h4>
        <p style="color:rgba(0,180,255,0.5);font-size:14px;">İşlem sırasında beklenmeyen bir hata meydana geldi. Lütfen tekrar deneyin.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm mt-2">
            <i class="bi bi-house me-1"></i>Ana Sayfaya Dön
        </a>
    </div>
</div>
