@model List<Ticket>
@{
    ViewData["Title"] = "Taleplerim";
    var openTickets = ViewBag.OpenTickets as List<Ticket> ?? new();
}

<div class="d-flex align-items-center gap-3 mb-4">
    <div style="width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,#0066ff,#00aaff);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="bi bi-person-lines-fill" style="color:#fff;font-size:20px;"></i>
    </div>
    <div>
        <h4 class="mb-0 fw-bold" style="color:#d0e8ff;">Taleplerim</h4>
        <div style="font-size:11px;color:rgba(0,180,255,0.5);font-family:monospace;">@Model.Count adet talep</div>
    </div>
</div>

@if (openTickets.Any())
{
    <div class="alert alert-warning mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Açık Talepleriniz (@openTickets.Count)</strong>
        </div>
        @foreach (var t in openTickets)
        {
            <div class="d-flex justify-content-between" style="font-size:13px;">
                <a asp-controller="Ticket" asp-action="Detail" asp-route-id="@t.Id" style="color:#ffc040;text-decoration:none;">
                    <i class="bi bi-dot"></i>#@t.Id — @t.Title
                </a>
                <small style="color:rgba(255,200,0,0.5);font-family:monospace;">@t.CreatedAt.ToString("dd.MM.yyyy")</small>
            </div>
        }
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div style="width:80px;height:80px;border-radius:16px;background:rgba(0,100,255,0.08);border:1px solid rgba(0,140,255,0.15);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <i class="bi bi-inbox" style="font-size:2.5rem;color:rgba(0,180,255,0.3);"></i>
        </div>
        <h6 style="color:rgba(0,180,255,0.5);">Henüz bir destek talebiniz yok.</h6>
        <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary btn-sm mt-2">
            <i class="bi bi-plus me-1"></i>İlk Talebimi Oluştur
        </a>
    </div>
}
else
{
    <div class="card shadow">
        <div class="list-group list-group-flush">
            @foreach (var ticket in Model)
            {
                var (statusClass, statusText) = ticket.Status switch
                {
                    TicketStatus.Acik => ("danger", "Açık"),
                    TicketStatus.Cozuldu => ("success", "Çözüldü"),
                    TicketStatus.Kapandi => ("secondary", "Kapandı"),
                    _ => ("secondary", ticket.Status.ToString())
                };
                <a asp-controller="Ticket" asp-action="Detail" asp-route-id="@ticket.Id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div style="font-weight:600;color:#d0e8ff;font-size:14px;">
                            <span style="font-family:monospace;color:rgba(0,180,255,0.5);font-size:12px;">#@ticket.Id</span>
                            — @ticket.Title
                        </div>
                        <div style="font-size:11px;color:rgba(0,180,255,0.4);font-family:monospace;margin-top:3px;">
                            @ticket.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            <span style="margin:0 6px;opacity:0.3">|</span>
                            Sorumlu: @(ticket.SupportAgent?.FullName ?? "Atanmadı")
                        </div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-@statusClass">@statusText</span>
                        <div style="font-size:11px;color:rgba(0,180,255,0.4);margin-top:3px;">
                            <i class="bi bi-chat me-1"></i>@ticket.Replies.Count yanıt
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
}
