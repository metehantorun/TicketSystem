@model RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header py-3">
                <div class="d-flex align-items-center gap-2">
                    <div style="width:30px;height:30px;border-radius:7px;background:linear-gradient(135deg,#0066ff,#00aaff);display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-person-plus" style="color:#fff;font-size:14px;"></i>
                    </div>
                    <div>
                        <div style="font-weight:800;color:#d0e8ff;font-size:14px;">Yeni Hesap Oluştur</div>
                        <div style="font-size:9px;color:rgba(0,180,255,0.6);text-transform:uppercase;letter-spacing:1px;">Sisteme katıl</div>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Ad Soyad</label>
                        <input asp-for="FullName" class="form-control" placeholder="Ad Soyad" />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-Posta</label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" class="form-control" placeholder="En az 6 karakter" />
                        <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrar</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-person-check me-1"></i>Kayıt Ol
                    </button>
                </form>

                <hr style="border-color:rgba(0,140,255,0.15);margin:20px 0;" />
                <div class="text-center">
                    <a asp-action="Login" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Zaten hesabım var
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
